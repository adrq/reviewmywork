{
  "name": "reviewmywork",
  "displayName": "Review My Work",
  "version": "0.2.0",
  "description": "AI Code Review Agent",
  "publisher": "adrq",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build-extension": "deno run --allow-read --allow-write --allow-run scripts/build-extension.ts",
    "build-all": "deno run --allow-read --allow-write --allow-run scripts/build-all.ts",
    "watch": "npm run compile -- --watch",
    "test": "deno task test",
    "test-all": "deno task test-all",
    "test-watch": "deno task test-watch",
    "test-vscode": "node --test tests/vscode/**/*.test.js",
    "package": "vsce package",
    "lint": "eslint src/ --ext .ts",
    "fmt": "prettier --write src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/azure": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "ai": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-promise": "^6.1.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "reviewmywork.review",
        "title": "Review My Work"
      },
      {
        "command": "reviewmywork.setApiKey",
        "title": "Review My Work: Set API Key"
      }
    ],
    "configuration": {
      "title": "Review My Work",
      "properties": {
        "reviewmywork.provider": {
          "type": "string",
          "enum": ["azure", "openai", "anthropic"],
          "description": "LLM provider to use. Required."
        },
        "reviewmywork.model": {
          "type": "string",
          "description": "Model name for the selected provider (e.g., gpt-4, claude-3-sonnet). Required."
        },
        "reviewmywork.azureResourceName": {
          "type": "string",
          "description": "Azure OpenAI resource name (required when using azure provider)"
        },
        "reviewmywork.azureDeployment": {
          "type": "string",
          "description": "Azure OpenAI deployment name (required when using azure provider)"
        },
        "reviewmywork.azureApiVersion": {
          "type": "string",
          "default": "2024-02-15-preview",
          "description": "Azure OpenAI API version (optional, has default)"
        },
        "reviewmywork.toolTimeout": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 3600,
          "description": "Timeout for tool execution in seconds (optional, default: 120)"
        },
        "reviewmywork.maxTurns": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of LLM turns for analysis (optional, default: 10)"
        },
        "reviewmywork.llmTimeout": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "maximum": 3600,
          "description": "Timeout for LLM calls in seconds (optional, default: 180)"
        }
      }
    }
  }
}
